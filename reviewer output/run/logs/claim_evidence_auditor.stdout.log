val was possible.","status":"cannot_verify","reason":"Claims are attributed to external sources that are not in the parsed artifacts and were not retrieved.","finding_ids":[],"attempted":true,"importance":"peripheral","scope":"sampled"},{"item_id":"claim:internal-consistency","source_object_ids":["OBJ-e13eccc23f4c883050d15bcf"],"claim":"Only one of 34 articles (3%) showed disagreement between three LLM runs; the pipeline cost NOK 70.","check_performed":"Checked 1/34 = 2.9 percent and the consistency of the one inconsistent article with Section 4.2.","status":"checked_no_issue","reason":"Arithmetic and the Stord article cross-reference are consistent; cost is not displayed beyond the stated figure.","finding_ids":[],"attempted":true,"importance":"peripheral","scope":"exhaustive"}]},"ttft_ms":2622,"type":"result","duration_ms":307125,"uuid":"7fa14fa2-7640-443c-a556-cbb3efc00f84","ttft_stream_ms":1425,"time_to_request_ms":169,"first_content_frame_ms":1426,"queued_turn_count":0,"result_index":0,"credential_expires_at":"2026-12-08T17:18:28.888Z"}
