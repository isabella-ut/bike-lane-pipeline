    {
      "id": "ROB-009",
      "category": "robustness_overstatement",
      "finding_summary": "The paper reads 17 of 18 ceremony projects versus 2 of 26 non-ceremony projects being day-dated as showing that date precision 'is not random', without conditioning on project size or the number of articles per project, which can mechanically raise the chance of a day-level date.",
      "issue_type": "manuscript_issue",
      "severity": "low",
      "confidence": "medium",
      "location": {
        "page": 11,
        "page_label": "11",
        "section": "6.3 Proposed econometric analysis",
        "text_quote": "without a reported ceremony. This suggests that the precision of the dates is not random but",
        "precision": "exact"
      },
      "claim_text": "Of these, 17 can be dated to the day, compared with 2 of the 26 projects without a reported ceremony. This suggests that the precision of the dates is not random but depends on how much attention an opening receives.",
      "assessment": "partially",
      "cannot_verify_reason": null,
      "evidence_summary": "This is a raw two-group comparison (about 94% versus 8%) with no test or adjustment. Project size, article count and outlet count are not controlled, and ceremony reporting is itself a coverage measure, so it may proxy for the number of articles giving a chance to state an exact date. The paper hedges with 'suggests' and proposes model (1), but then says a positive β 'would imply that results … should be reported separately', and that model (2) should use only precisely dated projects.",
      "source_objects": [
        {
          "id": "S1",
          "type": "text",
          "label": "Ceremony comparison",
          "path": "work/bicycle-infrastructure-paper/parsed/pages/page_011.md",
          "page": 11,
          "page_label": "11",
          "section": "6.3",
          "text_quote": "without a reported ceremony. This suggests that the precision of the dates is not random but",
          "url": null,
          "object_id": "OBJ-95b2618a59737e0b1725c4df",
          "correspondence": "text",
          "verification_note": null
        }
      ],
      "claim_evidence_links": [
        {
          "claim_text": "Date precision depends on attention",
          "source_object_ids": [
            "S1"
          ],
          "relation": "partial",
          "note": "Unconditional group difference only; confounding by coverage intensity not addressed."
        }
      ],
      "numeric_check": null,
      "suggested_fix": "Qualify the statement as an unadjusted descriptive contrast. Report precision by number of articles per project, or defer to model (1)."
    },
