    {
      "id": "ROB-002",
      "category": "specification_sensitivity",
      "finding_summary": "The headline 97% agreement is computed after two pre-opening Homborsund articles were recoded from relevant to not relevant, reducing relevant articles from five to three. Agreement under the original five-relevant coding is not reported.",
      "issue_type": "manuscript_issue",
